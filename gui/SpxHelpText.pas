    '<p><small><tt><a href="ex:75">#set %vip% = 1</a><br><a href="ex:75">{?vip?за вас|за св' +
      'е}</a><br>→&nbsp; За вас</tt></small></p>',
    '<p><small><tt><a href="ex:76">#set %n% = 5</a><br><a href="ex:76">%n% {plural %n%: арт' +
