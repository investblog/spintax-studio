    '<h2 id="conditions">Условия</h2>',
    '<p><code>{?имя?тогда|иначе}</code> спрашивает, есть ли у макроса значение.</p>',
    '<p><small><tt><a href="ex:17">#set %n% = 5</a><br><a href="ex:17">{?n?у нас %n%|пока н' +
