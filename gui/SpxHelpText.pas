  ATemplate := '';
  Result := (AIndex >= 0) and (AIndex < SpxHelpExampleCount(ALang));
  if Result then ATemplate := HELP_EX_TEMPLATE[HELP_EX_FIRST[ALang] + AIndex];
end;

