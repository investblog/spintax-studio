    '<h2 id="includes">Вставки</h2>',
    '<h3 id="includes-0"><code>#include</code> працює лише з початку рядка</h3>',
    '<p><small><tt><a href="ex:54">перед #include "frag" після</a><br>→&nbsp; Перед #includ' +
