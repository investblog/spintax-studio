    '<h3 id="variable.self-reference"><code>variable.self-reference</code> — определение сс' +
      'ылается само на себя</h3>',
    '<p><small><tt><a href="ex:9">#set %x% = а %x% б</a><br><a href="ex:9">%x%</a><br>→&nbs' +
