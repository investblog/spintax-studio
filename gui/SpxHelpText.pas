      '>',
    '<h2 id="counting">Счёт</h2>',
    '<p><code>{plural %n%: …}</code> подбирает форму слова к числу.</p>',
    '<p><small><tt><a href="ex:19">#def %n% = 1</a><br><a href="ex:19">%n% {plural %n%: фай' +
