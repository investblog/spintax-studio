<?xml version="1.0" encoding="utf-8"?>
<!--
  The package manifest, as a TEMPLATE: scripts/make-msix.py substitutes the at-sign names below
  and refuses to write a manifest that still holds one. Nothing here is edited by hand except
  the parts that are not substituted, and those are decisions rather than values.

  Written without a double hyphen anywhere, because XML forbids one inside a comment and
  MakeAppx says so only as "expected '>'" at a column. The prose here uses commas.

  IDENTITY IS NOT OURS TO INVENT. Name and Publisher must match what Partner Center reserves
  for the account, byte for byte, or the upload is rejected. Publisher in particular is the
  certificate subject Microsoft signs with, not a name we choose. Until the account exists the
  script fills placeholders and says so on every run; the values below are the SHAPE, not the
  answer.

  runFullTrust is what makes a packaged Win32 application a packaged Win32 application: it is a
  restricted capability, declared here and approved at submission, and every desktop bridge app
  carries it. Since ADR 0012 the application CAN make outgoing connections, when and only when
  the reader configures and allows them; see internetClient below for why that is declared.

  MinVersion 10.0.17763 (1809) is where MSIX for desktop settled; below it the platform wants
  the older appx story, and the Store's own floor for new desktop submissions is higher still.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>@DISPLAY_NAME@</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <!-- EVERY LANGUAGE THE WINDOW SPEAKS, because this is what the storefront advertises.

       It said `en-us` and nothing else until 2026-08-09, while the interface had spoken
       fourteen languages since before R0 and the help had answered in all fourteen since
       2026-08-07. `SupportedLanguages` on the live listing therefore read
       ["English (United States)"], a false claim about the product on its own storefront,
       the same class as the `LegalCopyright="MIT"` that shipped in 0.1.0.0, and it costs a
       reader searching in their own language an application that would have answered them.

       Nothing compared this list to `gui/lang/`; the suite now does, so a fifteenth language
       cannot be added to the window and forgotten here. `en-us` keeps its region because that
       is the declaration the package was certified with; the coverage check compares primary
       subtags, so `pt` and `pt-br` would count as the same language either way.

       SERBIAN CARRIES ITS SCRIPT AND THE OTHER THIRTEEN DO NOT, for two independent reasons,
       and `sr` was wrong under both. It shipped in 0.2.0.0 and made the package IMPOSSIBLE TO
       INSTALL: Windows refuses to register a package whose resource language is a script
       required language written without one, and reports it as 0x80073CF6 wrapping 0x80070057,
       "the specified resource language is invalid". The Store had certified it, because
       certification reads the manifest schema and never calls Add-AppxPackage, so the first
       reader to press Get saw the Store's own "Something went wrong". Measured on 2026-08-18 by
       registering a minimal package one language at a time: the other thirteen all register,
       `sr` and `sr-RS` do not, `sr-Latn` and `sr-Cyrl` do with or without a region.

       And the SECOND reason survives the first: Microsoft's published list of Store languages
       puts a bare `sr` under Serbian (LATIN), beside `sr-latn-rs` and the rest, while
       `gui/lang/SpxTextsSr.pas` is Cyrillic. So the tag advertised the wrong script as well as
       being unregisterable, which is why the live storefront read "Serbian" next to the
       correctly resolved "Bosnian (Latin)". Bosnian and Croatian are Latin in `gui/lang/` and
       their bare tags resolve to Latin rows, so they are right as written.

       `sr-Latn` is NOT declared, deliberately. This list is read as the languages the WINDOW
       speaks, and the window has no Latin string table; a Serbian Latin STORE LISTING is a
       Partner Center "additional Store listing language" and needs nothing here. A reader
       whose system is `sr-Latn-RS` already gets the application in Serbian either way, because
       SpxLangFor cuts the tag at its first separator. -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ru" />
    <Resource Language="uk" />
    <Resource Language="be" />
    <Resource Language="sr-Cyrl" />
    <Resource Language="hr" />
    <Resource Language="bs" />
    <Resource Language="de" />
    <Resource Language="fr" />
    <Resource Language="es" />
    <Resource Language="it" />
    <Resource Language="pt" />
    <Resource Language="nl" />
    <Resource Language="tr" />
  </Resources>

  <Applications>
    <Application Id="SpintaxStudio"
                 Executable="spintax-studio.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="@DISPLAY_NAME@"
        Description="@DESCRIPTION@"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\SmallTile.png"
                         Square310x310Logo="Assets\LargeTile.png"
                         Wide310x150Logo="Assets\WideTile.png" />
      </uap:VisualElements>
      <!--
        THE FILE TYPE, CLAIMED DECLARATIVELY. `.spintax` is this application's own extension
        (SpxFiles.SPX_EXT), and nothing else on a machine claims it. Declaring it here rather
        than writing registry keys is the whole point of the MSIX path: the association appears
        on install, disappears on uninstall, and needs no elevation — which is also what makes
        it acceptable to Store certification.

        The application already opens a path handed to it on the command line
        (SpxMainForm.pas:559), so a double-click works the moment this exists; nothing in the
        code has to change.

        Name is the association's identifier and must be lower-case alphanumeric — it is not
        shown to anyone. DisplayName is what Explorer's type column says.
      -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="spintax">
            <uap:DisplayName>Spintax template</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.spintax</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      internetClient is TECHNICALLY unnecessary and declared on purpose (owner's decision,
      2026-08-09, recorded when the network slice opened): a runFullTrust package runs at
      medium IL and reaches the network as the user regardless. Declaring it is what makes
      the STOREFRONT say "uses your internet connection" before anyone installs, which is
      the honest half of an opt-in AI feature. The suite pins this pair exactly, so neither
      line can leave or gain company unnoticed.
    -->
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
