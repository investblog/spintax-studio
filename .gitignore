# Baseline (from the canon library's template) + the Free Pascal / Lazarus stack.

# secrets — never commit (templates like .env.example are kept)
.env
.env.*
!.env.example
.dev.vars
.secrets
*.pem
id_rsa
id_ed25519

# LLM provider keys and local model config — this app talks to Anthropic / OpenAI /
# Google / a local endpoint, and the keys are the user's. They live in %APPDATA% or the
# Windows Credential Manager at runtime; a key must never be committable.
*.key
apikeys.*
providers.local.*

# dependencies
node_modules/
.venv/
venv/
__pycache__/

# build / generated artifacts
dist/
build/
*.log

# local indexes — regenerable caches; never commit
.codegraph/
.docindex/

# OS junk
.DS_Store
Thumbs.db

# --- Free Pascal / Lazarus / Delphi ---
# compiler units and intermediates
*.o
*.ppu
*.or
*.a
*.compiled
*.res
# ...except the app icon's, which is not a compiler product: SpintaxStudio.res is regenerated
# by lazbuild from the .lpi and belongs here, but SpxAppIcon.res is written by
# scripts/make-appicon.py and is an INPUT to the build. A clone without it links an exe with
# no icon, and CI has no Pillow to rebuild it.
!gui/SpxAppIcon.res
*.rsj
*.dcu
lib/
backup/
__history/
__recovery/

# fpc drops its link script beside the sources
ppas.bat
ppas.sh

# built binaries — a source repo tracks no executable. A blanket *.exe first, then the
# extensionless targets: fpc honours -o literally, so on Windows too the binary has no
# suffix and *.exe would sail right past it.
*.exe
tests/studio_tests
tests/studio_tests_checked

# Lazarus / Delphi per-user session state — machine-local, never shared
*.lps
*.identcache
*.local
*.dproj.local
*.dsk

# IDE build output
Win32/
Win64/
Debug/
Release/

# Store listing artwork -- tiles, promo, box and poster art, and the SVGs they render from.
# Rendered for Partner Center rather than built into the product: nothing in the application
# or in scripts/make-msix.py reads them, and the package takes its own tiles from
# assets/brand/. They are large, binary, and regenerated whenever the listing changes, so a
# source repo is the wrong place to keep them. The MARK they all derive from is tracked --
# assets/brand/ -- which is the part a clone actually needs.
assets/store/

# Agent working state, not the product. It is instructions for the tooling that builds
# the app, not something a reader of this repository needs. It stays ON DISK so a session
# opened here still gets its charter; only the repository is kept free of it — the same
# split the engine repo uses.
.claude/
.agents/
AGENTS.md
CLAUDE.md

# Store listing drafts, per language. Deliberately NOT tracked: this is marketing copy under
# review, not a product artefact, and it changes on a different clock from the code. What IS
# tracked is the English source it must agree with (docs/store-listing.md) and the script that
# compares them (scripts/check-listing-drafts.py).
marketing/
