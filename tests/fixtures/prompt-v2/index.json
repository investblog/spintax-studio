   "locale": "en",
   "channel": "email",
   "variationLevel": "balanced",
   "allowedVariables": [],
   "brief": "Write a short, friendly welcome email (3-4 sentences) for a productivity app called FocusDesk. One clear call to action: open the dashboard."
  },
  {
   "id": "en-email-vars-conditional",
   "kind": "authoring",
   "locale": "en",
   "channel": "email",
   "variationLevel": "balanced",
   "allowedVariables": [
    {
     "name": "first_name",
     "note": "recipient's first name"
    },
    {
     "name": "company",
     "note": "recipient's company"
    },
    {
     "name": "has_discount",
     "note": "optional — empty when the account has no discount"
    }
   ],
   "brief": "Write a short onboarding email for %first_name% at %company%. If %has_discount% is set, mention their discount is already applied; otherwise do not mention pricing at all. 3-5 sentences, one call to action."
  },
  {
   "id": "en-product-plural",
   "kind": "authoring",
   "locale": "en",
   "channel": "landing",
   "variationLevel": "balanced",
   "allowedVariables": [
    {
     "name": "product"
    },
    {
     "name": "price"
    },
    {
     "name": "in_stock",
     "note": "a count — an integer number of units"
    }
   ],
   "brief": "Write a two-sentence e-commerce product blurb for %product% priced at %price%. Mention that there are %in_stock% units in stock — the sentence must stay grammatical whether it is 1 or many."
  },
  {
   "id": "en-landing-lastsep",
   "kind": "authoring",
   "locale": "en",
   "channel": "landing",
   "variationLevel": "aggressive",
   "allowedVariables": [],
   "brief": "Write a one-paragraph landing-page intro for a team chat app. In one sentence, list three to four of these selling points in varying order: fast search, thread summaries, offline mode, granular permissions. The list must read naturally in prose (with a proper 'and' before the last item)."
  },
  {
   "id": "en-sms-conservative",
   "kind": "authoring",
   "locale": "en",
   "channel": "sms",
   "variationLevel": "conservative",
   "allowedVariables": [
    {
     "name": "first_name"
    },
    {
     "name": "days_left",
     "note": "a count of days"
    },
    {
     "name": "link",
     "note": "already a complete URL — do not wrap or spin it"
    }
   ],
   "brief": "Write an SMS (max ~2 short sentences) reminding %first_name% that their trial ends in %days_left% days. Include a short link placeholder %link%. Keep wording variation minimal."
  },
  {
   "id": "ru-email-light",
   "kind": "authoring",
   "locale": "ru",
   "channel": "email",
   "variationLevel": "balanced",
   "allowedVariables": [
    {
     "name": "Name",
